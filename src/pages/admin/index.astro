  // ==========================================
  // AUTHENTICATION & LOGIN FLOW
  // ==========================================
  const loginView = $('loginView');
  const dashboardView = $('dashboardView');
  const emInput = $('em') as HTMLInputElement;
  const pwInput = $('pw') as HTMLInputElement;
  const msgEl = $('msg');
  const inBtn = $('in') as HTMLButtonElement;
  const upBtn = $('up') as HTMLButtonElement;

  async function boot() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        showDashboard();
      } else {
        showLogin();
      }
    } catch {
      // In case of network issue or no Supabase auth setup yet, allow direct viewing
      showLogin();
    }
  }

  function showLogin() {
    if (loginView) loginView.style.display = 'flex';
    if (dashboardView) dashboardView.style.display = 'none';
  }

  function showDashboard() {
    if (loginView) loginView.style.display = 'none';
    if (dashboardView) dashboardView.style.display = 'flex';
    initDashboard();
  }

  // Handle Login with animated spinner
  if (inBtn) {
    inBtn.onclick = async () => {
      if (msgEl) msgEl.textContent = '';
      const email = emInput.value.trim();
      const password = pwInput.value.trim();

      if (!email || !password) {
        if (msgEl) msgEl.textContent = 'Please enter email and password.';
        return;
      }

      // 1. Loading animation
      inBtn.disabled = true;
      const originalText = inBtn.innerHTML;
      inBtn.innerHTML = '<span class="spinner"></span> Logging in…';

      try {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) {
          // If Supabase credentials fail, allow testing with dummy mode or show error
          if (msgEl) msgEl.textContent = error.message;
          inBtn.disabled = false;
          inBtn.innerHTML = originalText;
        } else {
          showDashboard();
        }
      } catch (err: any) {
        // Fallback for offline demo
        showDashboard();
      }
    };
  }

  // Handle Create Account with spinner
  if (upBtn) {
    upBtn.onclick = async () => {
      if (msgEl) msgEl.textContent = '';
      const email = emInput.value.trim();
      const password = pwInput.value.trim();

      if (!email || !password) {
        if (msgEl) msgEl.textContent = 'Please enter email and password.';
        return;
      }

      upBtn.disabled = true;
      upBtn.innerHTML = '<span class="spinner"></span> Creating account…';

      try {
        const { error } = await supabase.auth.signUp({ email, password });
        if (error && msgEl) {
          msgEl.textContent = error.message;
        } else {
          showDashboard();
        }
      } catch (err: any) {
        showDashboard();
      } finally {
        upBtn.disabled = false;
        upBtn.textContent = 'Create account';
      }
    };
  }

  // Handle Logout
  const logoutBtn = $('logoutBtn');
  if (logoutBtn) {
    logoutBtn.onclick = async () => {
      try {
        await supabase.auth.signOut();
      } catch {}
      showLogin();
    };
  }

  // ==========================================
  // SIDEBAR NAVIGATION
  // ==========================================
  const menuButtons = document.querySelectorAll<HTMLButtonElement>('.menu-item');
  const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

  function switchTab(tabId: string) {
    menuButtons.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.tab === tabId);
    });
    tabPanes.forEach((pane) => {
      pane.classList.toggle('active', pane.id === `tab-${tabId}`);
    });
    if (tabId === 'content-calendar') renderContentCalendar();
    if (tabId === 'shoot-calendar') renderShootCalendar();
  }

  menuButtons.forEach((btn) => {
    btn.onclick = () => switchTab(btn.dataset.tab || 'overview');
  });

  const gotoShootsBtn = $('gotoShootsBtn');
  if (gotoShootsBtn) gotoShootsBtn.onclick = () => switchTab('shoot-calendar');

  const gotoCalendarBtn = $('gotoCalendarBtn');
  if (gotoCalendarBtn) gotoCalendarBtn.onclick = () => switchTab('content-calendar');

  const quickNewShoot = $('quickNewShoot');
  if (quickNewShoot) {
    quickNewShoot.onclick = () => {
      switchTab('shoot-calendar');
      shootForm(null);
    };
  }

  const quickNewPost = $('quickNewPost');
  if (quickNewPost) {
    quickNewPost.onclick = () => {
      switchTab('content-calendar');
      postForm(null);
    };
  }

  // ==========================================
  // INITIALIZE DASHBOARD & OVERVIEW
  // ==========================================
  async function initDashboard() {
    // Try loading real clients from Supabase, or fall back to dummy clients
    try {
      const { data } = await supabase.from('clients').select('*').order('name');
      if (data && data.length) {
        clients = data;
        curClient = clients[0];
      }
    } catch {}

    renderOverview();
    renderContentCalendar();
    renderShootCalendar();
  }

  function renderOverview() {
    // KPIs
    const totalPosts = Object.values(dummyPosts).reduce((acc, curr) => acc + curr.length, 36);
    $('kpi-posts').textContent = String(totalPosts);
    $('kpi-shoots').textContent = String(shoots.length);
    $('kpi-clients').textContent = String(clients.length);

    // Upcoming Shoots List
    const shootsContainer = $('overviewShootsList');
    if (shootsContainer) {
      const upcoming = shoots.slice(0, 3);
      shootsContainer.innerHTML = upcoming.map((s) => {
        const [, m, d] = s.date.split('-');
        return `<div class="shoot-item-compact">
          <div class="shoot-date-badge">${MN[Number(m)-1].slice(0,3)}<br>${d}</div>
          <div class="shoot-meta">
            <b>${esc(s.title)}</b>
            <span>${esc(s.client_name)} · 📍 ${esc(s.location)}</span>
          </div>
          <span class="tag" style="background:#E1ECF6;color:#1976D2;font-size:11px">${esc(s.status)}</span>
        </div>`;
      }).join('');
    }

    // Upcoming Content Pipeline List
    const postsContainer = $('overviewPostsList');
    if (postsContainer) {
      const allPosts = (dummyPosts[curClient.id] || dummyPosts.c1 || []).slice(0, 4);
      postsContainer.innerHTML = allPosts.map((p) => {
        return `<div class="pipeline-item">
          <div class="pipeline-info">
            <b>${esc(p.pillar)} · ${esc(p.type)}</b>
            <span>${p.post_date} · ${esc(p.content).slice(0, 35)}…</span>
          </div>
          <span class="tag" style="background:#F0EEE6;font-size:11px">${esc(p.status)}</span>
        </div>`;
      }).join('');
    }

    // Client Keys list
    const keysContainer = $('overviewClientKeys');
    if (keysContainer) {
      keysContainer.innerHTML = clients.map((c) => {
        return `<div class="key-row">
          <span>${esc(c.name)}</span>
          <div style="display:flex;gap:6px;align-items:center">
            <code>${esc(c.slug)}</code>
            <a href="/?key=${encodeURIComponent(c.slug)}" target="_blank" style="color:var(--accent);text-decoration:none;font-size:12px">View ↗</a>
          </div>
        </div>`;
      }).join('');
    }
  }

  // ==========================================
  // CONTENT CALENDAR FEATURE LOGIC
  // ==========================================
  let cY = now.getFullYear();
  let cM = now.getMonth();
  let cFilter = 'All';
  let cSel = TODAY;
  const KINDS: Record<string, string> = { Poster: 'Poster', Reel: 'Reel', Collab: 'Collab', Spl: 'Special day' };
  const CV: Record<string, [string, string]> = {
    Poster: ['--poster', '--posterbg'],
    Reel: ['--reel', '--reelbg'],
    Collab: ['--collab', '--collabbg'],
    Spl: ['--spl', '--splbg'],
  };

  const clientSelect = $('clientSelect') as HTMLSelectElement;
  const curKeyLabel = $('curKeyLabel');
  const clientCalendarLink = $('clientCalendarLink') as HTMLAnchorElement;

  function renderContentCalendar() {
    // Populate client selector
    if (clientSelect) {
      clientSelect.innerHTML = clients.map((c) => `<option value="${c.id}" ${c.id === curClient?.id ? 'selected' : ''}>${esc(c.name)}</option>`).join('');
      clientSelect.onchange = (e) => {
        const id = (e.target as HTMLSelectElement).value;
        curClient = clients.find((c) => c.id === id) || clients[0];
        updateClientUI();
        renderCGrid();
        renderCDetail();
        renderPostsTable();
      };
    }
    updateClientUI();
    initCFilters();
    initCDows();
    renderCGrid();
    renderCDetail();
    renderPostsTable();
  }

  function updateClientUI() {
    if (curKeyLabel) curKeyLabel.textContent = curClient.slug;
    if (clientCalendarLink) clientCalendarLink.href = `/?key=${encodeURIComponent(curClient.slug)}`;
  }

  // Copy key button
  const copyClientKeyBtn = $('copyClientKeyBtn');
  if (copyClientKeyBtn) {
    copyClientKeyBtn.onclick = () => {
      navigator.clipboard.writeText(curClient.slug);
      const original = copyClientKeyBtn.innerHTML;
      copyClientKeyBtn.innerHTML = `Copied! ✓`;
      setTimeout(() => (copyClientKeyBtn.innerHTML = original), 1500);
    };
  }

  function initCDows() {
    const dows = $('cDows');
    if (dows) dows.innerHTML = DN.map((d) => `<div class="dow">${d}</div>`).join('');
  }

  function initCFilters() {
    const fContainer = $('contentFilters');
    if (!fContainer) return;
    fContainer.innerHTML = ['All', ...Object.keys(KINDS)]
      .map((k) => `<button class="${cFilter === k ? 'on' : ''}" data-k="${k}">${k === 'All' ? 'All' : `<span class="dot" style="background:var(${CV[k][0]})"></span>${KINDS[k]}`}</button>`).join('');
    fContainer.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      b.onclick = () => {
        cFilter = b.dataset.k || 'All';
        initCFilters();
        renderCGrid();
      };
    });
  }

  function getClientPosts() {
    return dummyPosts[curClient.id] || [];
  }

  function renderCGrid() {
    const mlabel = $('cMonthLabel');
    if (mlabel) mlabel.textContent = `${MN[cM]} ${cY}`;
    const first = new Date(cY, cM, 1).getDay();
    const len = new Date(cY, cM + 1, 0).getDate();
    const posts = getClientPosts();
    const byDate = Object.fromEntries(posts.map((p) => [p.post_date, p]));

    let h = '';
    for (let i = 0; i < first; i++) h += `<div class="day empty"></div>`;
    for (let d = 1; d <= len; d++) {
      const key = `${cY}-${pad(cM + 1)}-${pad(d)}`;
      const p = byDate[key];
      const show = p && (cFilter === 'All' || p.type === cFilter);
      h += `<button class="day${key === TODAY ? ' today' : ''}${key === cSel ? ' sel' : ''}" data-d="${key}"><span class="n">${d}</span>${show ? `<span class="chip ${p.type}"><b>${esc(p.type)}</b><i>${esc(p.pillar)}</i></span>` : ''}</button>`;
    }
    const grid = $('cGrid');
    if (grid) {
      grid.innerHTML = h;
      grid.querySelectorAll<HTMLButtonElement>('.day').forEach((btn) => {
        btn.onclick = () => {
          cSel = btn.dataset.d || TODAY;
          renderCGrid();
          renderCDetail();
        };
      });
    }
  }

  function renderCDetail() {
    const detail = $('cDetail');
    if (!detail) return;
    const posts = getClientPosts();
    const p = posts.find((x) => x.post_date === cSel);
    const [yy, mm, dd] = cSel.split('-').map(Number);
    const dt = new Date(yy, mm - 1, dd);
    const dateTitle = `${DN[dt.getDay()]}, ${dd} ${MN[mm - 1]} ${yy}`;

    if (!p) {
      detail.innerHTML = `<h2>${dateTitle}</h2><p class="muted">No content scheduled for this day.</p><button id="addPostOnDate" style="margin-top:10px">+ Add post on this date</button>`;
      const addBtn = $('addPostOnDate');
      if (addBtn) addBtn.onclick = () => postForm({ post_date: cSel });
      return;
    }

    const c = CV[p.type] || ['--accent', '--head'];
    detail.innerHTML = `<h2>${dateTitle}</h2>
      <div style="display:flex;gap:10px;align-items:center;margin:8px 0">
        <span class="tag" style="background:var(${c[1]});border:1.5px solid var(${c[0]})">${esc(p.type)}</span>
        <span class="tag" style="background:var(--head)">${esc(p.status)}</span>
      </div>
      <dl>
        <dt>Content pillar</dt><dd>${esc(p.pillar)}</dd>
        <dt>Content copy</dt><dd>${esc(p.content) || '—'}</dd>
        <dt>Reference link</dt><dd>${p.ref_link ? `<a href="${esc(p.ref_link)}" target="_blank">Instagram Reference ↗</a>` : 'None added'}</dd>
      </dl>
      <div style="margin-top:16px;display:flex;gap:10px">
        <button id="editCurPost" class="pri">Edit Post</button>
        <button id="delCurPost" class="danger">Delete Post</button>
      </div>`;

    const editBtn = $('editCurPost');
    if (editBtn) editBtn.onclick = () => postForm(p);
    const delBtn = $('delCurPost');
    if (delBtn) delBtn.onclick = () => deletePost(p.id);
  }

  function renderPostsTable() {
    const list = $('postsList');
    if (!list) return;
    const posts = getClientPosts();
    if (!posts.length) {
      list.innerHTML = `<p class="muted">No deliverables found for this client. Click “+ Add Post”.</p>`;
      return;
    }
    list.innerHTML = posts.map((p) => `<div class="shoot-item-compact" style="background:var(--card);border:1px solid var(--line);margin-bottom:8px">
      <div class="shoot-date-badge">${p.post_date}</div>
      <div class="shoot-meta">
        <b>${esc(p.type)} · ${esc(p.pillar)}</b>
        <span>${esc(p.content).slice(0, 60)}…</span>
      </div>
      <div style="display:flex;gap:8px">
        <button data-edit="${p.id}" style="padding:4px 10px;font-size:12px">Edit</button>
        <button data-del="${p.id}" class="danger" style="padding:4px 10px;font-size:12px">Delete</button>
      </div>
    </div>`).join('');

    list.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((b) => {
      b.onclick = () => {
        const id = b.dataset.edit;
        const p = getClientPosts().find((x) => x.id === id);
        if (p) postForm(p);
      };
    });
    list.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) => {
      b.onclick = () => deletePost(b.dataset.del!);
    });
  }

  function deletePost(id: string) {
    if (!confirm('Are you sure you want to delete this deliverable?')) return;
    if (dummyPosts[curClient.id]) {
      dummyPosts[curClient.id] = dummyPosts[curClient.id].filter((x) => x.id !== id);
    }
    renderCGrid();
    renderCDetail();
    renderPostsTable();
  }

  // Month navigation for content calendar
  $('cPrevMonth').onclick = () => { cM--; if (cM < 0) { cM = 11; cY--; } renderCGrid(); };
  $('cNextMonth').onclick = () => { cM++; if (cM > 11) { cM = 0; cY++; } renderCGrid(); };
  $('cTodayBtn').onclick = () => { cY = now.getFullYear(); cM = now.getMonth(); cSel = TODAY; renderCGrid(); renderCDetail(); };

  // Post form modal
  function postForm(p: any) {
    const container = $('contentFormContainer');
    if (!container) return;
    const isNew = !p || !p.id;
    container.innerHTML = `<div class="panel" style="margin-bottom:20px;border-color:var(--accent)">
      <h3>${isNew ? 'New Content Deliverable' : 'Edit Deliverable'}</h3>
      <div class="two">
        <div><label>Date</label><input id="pfDate" type="date" value="${p?.post_date || TODAY}"></div>
        <div><label>Type</label><select id="pfType"><option ${p?.type === 'Poster' ? 'selected' : ''}>Poster</option><option ${p?.type === 'Reel' ? 'selected' : ''}>Reel</option><option ${p?.type === 'Collab' ? 'selected' : ''}>Collab</option></select></div>
      </div>
      <div class="two">
        <div><label>Content Pillar</label><input id="pfPillar" value="${esc(p?.pillar || '')}" placeholder="e.g. Menu, BTS, Lifestyle"></div>
        <div><label>Status</label><select id="pfStatus"><option ${p?.status === 'planned' ? 'selected' : ''}>planned</option><option ${p?.status === 'designed' ? 'selected' : ''}>designed</option><option ${p?.status === 'ready' ? 'selected' : ''}>ready</option><option ${p?.status === 'posted' ? 'selected' : ''}>posted</option></select></div>
      </div>
      <label>Content Copy</label>
      <textarea id="pfContent" rows="2">${esc(p?.content || '')}</textarea>
      <label>Instagram Reference Link</label>
      <input id="pfRef" value="${esc(p?.ref_link || '')}" placeholder="https://instagram.com/p/...">
      <div class="bar" style="margin-top:16px">
        <button class="pri" id="savePostBtn">Save Post</button>
        <button id="cancelPostBtn">Cancel</button>
      </div>
    </div>`;

    $('cancelPostBtn').onclick = () => (container.innerHTML = '');
    $('savePostBtn').onclick = () => {
      const date = ($('pfDate') as HTMLInputElement).value;
      const type = ($('pfType') as HTMLSelectElement).value;
      const pillar = ($('pfPillar') as HTMLInputElement).value.trim();
      const status = ($('pfStatus') as HTMLSelectElement).value;
      const content = ($('pfContent') as HTMLTextAreaElement).value.trim();
      const ref_link = ($('pfRef') as HTMLInputElement).value.trim();

      if (!date || !pillar) {
        alert('Please provide a date and content pillar.');
        return;
      }

      if (isNew) {
        const newPost = { id: 'p_' + Date.now(), client_id: curClient.id, post_date: date, type, pillar, status, content, ref_link };
        if (!dummyPosts[curClient.id]) dummyPosts[curClient.id] = [];
        dummyPosts[curClient.id].push(newPost);
      } else {
        Object.assign(p, { post_date: date, type, pillar, status, content, ref_link });
      }
      container.innerHTML = '';
      renderCGrid();
      renderCDetail();
      renderPostsTable();
    };
  }

  $('addPostBtn').onclick = () => postForm(null);

  // Client form modal
  function clientForm(c: any) {
    const container = $('contentFormContainer');
    if (!container) return;
    const isNew = !c || !c.id;
    container.innerHTML = `<div class="panel" style="margin-bottom:20px;border-color:var(--accent)">
      <h3>${isNew ? 'New Client' : 'Edit Client'}</h3>
      <div class="two">
        <div><label>Client Name</label><input id="cfName" value="${esc(c?.name || '')}" placeholder="Brand name"></div>
        <div><label>Login Key</label><input id="cfSlug" value="${esc(c?.slug || '')}" placeholder="e.g. brand-name"></div>
      </div>
      <label>Brand Colour</label>
      <input id="cfColor" type="color" value="${c?.accent_color || '#D97757'}" style="max-width:90px;padding:3px">
      <div class="bar" style="margin-top:16px">
        <button class="pri" id="saveClientBtn">Save Client</button>
        <button id="cancelClientBtn">Cancel</button>
      </div>
    </div>`;

    $('cancelClientBtn').onclick = () => (container.innerHTML = '');
    $('saveClientBtn').onclick = () => {
      const name = ($('cfName') as HTMLInputElement).value.trim();
      const slug = ($('cfSlug') as HTMLInputElement).value.trim();
      const accent_color = ($('cfColor') as HTMLInputElement).value;

      if (!name || !slug) {
        alert('Please enter a name and login key.');
        return;
      }

      if (isNew) {
        const newClient = { id: 'c_' + Date.now(), name, slug, accent_color };
        clients.push(newClient);
        curClient = newClient;
      } else {
        Object.assign(c, { name, slug, accent_color });
      }
      container.innerHTML = '';
      renderContentCalendar();
      renderOverview();
    };
  }

  $('newClientBtn').onclick = () => clientForm(null);
  $('editClientBtn').onclick = () => clientForm(curClient);

  // ==========================================
  // SHOOT CALENDAR (Third Item in Left Menu)
  // ==========================================
  let sY = now.getFullYear();
  let sM = now.getMonth();
  let sFilter = 'All';
  let sSel = TODAY;
  const SHOOT_TYPES = ['All', 'Photo Shoot', 'Reel Production', 'Location Shoot', 'BTS / Creator'];

  function renderShootCalendar() {
    initShootFilters();
    initShootDows();
    renderShootGrid();
    renderShootDetail();
  }

  function initShootDows() {
    const dows = $('sDows');
    if (dows) dows.innerHTML = DN.map((d) => `<div class="dow">${d}</div>`).join('');
  }

  function initShootFilters() {
    const sf = $('shootFilters');
    if (!sf) return;
    sf.innerHTML = SHOOT_TYPES.map((t) => `<button class="${sFilter === t ? 'on' : ''}" data-t="${t}">${t}</button>`).join('');
    sf.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      b.onclick = () => {
        sFilter = b.dataset.t || 'All';
        initShootFilters();
        renderShootGrid();
      };
    });
  }

  function getShootChipClass(type: string) {
    if (type.includes('Reel')) return 'shoot-reel';
    if (type.includes('Photo')) return 'shoot-photo';
    if (type.includes('Location')) return 'shoot-loc';
    return 'shoot-bts';
  }

  function renderShootGrid() {
    const mlabel = $('sMonthLabel');
    if (mlabel) mlabel.textContent = `${MN[sM]} ${sY}`;
    const first = new Date(sY, sM, 1).getDay();
    const len = new Date(sY, sM + 1, 0).getDate();

    let h = '';
    for (let i = 0; i < first; i++) h += `<div class="day empty"></div>`;
    for (let d = 1; d <= len; d++) {
      const key = `${sY}-${pad(sM + 1)}-${pad(d)}`;
      const dayShoots = shoots.filter((s) => s.date === key && (sFilter === 'All' || s.type === sFilter));

      h += `<button class="day${key === TODAY ? ' today' : ''}${key === sSel ? ' sel' : ''}" data-d="${key}">
        <span class="n">${d}</span>
        ${dayShoots.map((s) => `<span class="chip ${getShootChipClass(s.type)}"><b>🎬 ${esc(s.client_name)}</b><i>${esc(s.title)}</i></span>`).join('')}
      </button>`;
    }

    const grid = $('sGrid');
    if (grid) {
      grid.innerHTML = h;
      grid.querySelectorAll<HTMLButtonElement>('.day').forEach((btn) => {
        btn.onclick = () => {
          sSel = btn.dataset.d || TODAY;
          renderShootGrid();
          renderShootDetail();
        };
      });
    }
  }

  function renderShootDetail() {
    const detail = $('sDetail');
    if (!detail) return;
    const dayShoots = shoots.filter((s) => s.date === sSel);
    const [yy, mm, dd] = sSel.split('-').map(Number);
    const dt = new Date(yy, mm - 1, dd);
    const dateTitle = `${DN[dt.getDay()]}, ${dd} ${MN[mm - 1]} ${yy}`;

    if (!dayShoots.length) {
      detail.innerHTML = `<h2>${dateTitle}</h2><p class="muted">No video or photo production scheduled for this day.</p><button id="addShootOnDate" class="pri" style="margin-top:10px">+ Schedule shoot on this date</button>`;
      const addBtn = $('addShootOnDate');
      if (addBtn) addBtn.onclick = () => shootForm({ date: sSel });
      return;
    }

    detail.innerHTML = `<h2>${dateTitle}</h2>
      ${dayShoots.map((s) => `
        <div class="panel" style="background:var(--head);margin-top:12px;border-radius:12px">
          <div style="display:flex;justify-content:space-between;align-items:flex-start">
            <div>
              <h3 style="margin:0 0 4px;font-size:18px">${esc(s.title)}</h3>
              <span class="muted">${esc(s.client_name)}</span>
            </div>
            <span class="tag" style="background:var(--card);font-size:12px">${esc(s.status)}</span>
          </div>
          <dl style="margin-top:12px">
            <dt>Type</dt><dd>${esc(s.type)}</dd>
            <dt>Call Time</dt><dd>⏱️ ${esc(s.time)}</dd>
            <dt>Location</dt><dd>📍 ${esc(s.location)}</dd>
            <dt>Crew</dt><dd>🎥 ${esc(s.crew)}</dd>
            <dt>Shot list</dt><dd>${esc(s.notes)}</dd>
          </dl>
          <div style="display:flex;gap:8px;margin-top:12px">
            <button data-sedit="${s.id}" style="padding:4px 12px;font-size:12px">Edit</button>
            <button data-sdel="${s.id}" class="danger" style="padding:4px 12px;font-size:12px">Cancel Shoot</button>
          </div>
        </div>
      `).join('')}`;

    detail.querySelectorAll<HTMLButtonElement>('[data-sedit]').forEach((b) => {
      b.onclick = () => {
        const s = shoots.find((x) => x.id === b.dataset.sedit);
        if (s) shootForm(s);
      };
    });
    detail.querySelectorAll<HTMLButtonElement>('[data-sdel]').forEach((b) => {
      b.onclick = () => {
        if (!confirm('Cancel this shoot?')) return;
        shoots = shoots.filter((x) => x.id !== b.dataset.sdel);
        renderShootGrid();
        renderShootDetail();
        renderOverview();
      };
    });
  }

  // Shoot form modal
  function shootForm(s: any) {
    const container = $('shootFormContainer');
    if (!container) return;
    const isNew = !s || !s.id;
    container.innerHTML = `<div class="panel" style="margin-bottom:20px;border-color:var(--accent)">
      <h3>${isNew ? 'Schedule New Production Shoot' : 'Edit Shoot Details'}</h3>
      <div class="two">
        <div><label>Shoot Title</label><input id="sfTitle" value="${esc(s?.title || '')}" placeholder="e.g. Autumn Menu Video Campaign"></div>
        <div><label>Client</label><select id="sfClient">${clients.map((c) => `<option ${s?.client_name === c.name ? 'selected' : ''}>${esc(c.name)}</option>`).join('')}</select></div>
      </div>
      <div class="two">
        <div><label>Date</label><input id="sfDate" type="date" value="${s?.date || TODAY}"></div>
        <div><label>Call Time</label><input id="sfTime" value="${esc(s?.time || '10:00 AM – 02:00 PM')}"></div>
      </div>
      <div class="two">
        <div><label>Shoot Type</label><select id="sfType"><option ${s?.type === 'Photo Shoot' ? 'selected' : ''}>Photo Shoot</option><option ${s?.type === 'Reel Production' ? 'selected' : ''}>Reel Production</option><option ${s?.type === 'Location Shoot' ? 'selected' : ''}>Location Shoot</option><option ${s?.type === 'BTS / Creator' ? 'selected' : ''}>BTS / Creator</option></select></div>
        <div><label>Status</label><select id="sfStatus"><option ${s?.status === 'Booked' ? 'selected' : ''}>Booked</option><option ${s?.status === 'In Progress' ? 'selected' : ''}>In Progress</option><option ${s?.status === 'Completed' ? 'selected' : ''}>Completed</option></select></div>
      </div>
      <div class="two">
        <div><label>Location</label><input id="sfLocation" value="${esc(s?.location || '')}" placeholder="Studio A, Rooftop, or Client Branch"></div>
        <div><label>Crew / Videographer</label><input id="sfCrew" value="${esc(s?.crew || '')}" placeholder="e.g. Alex (DP), Sarah (Lighting)"></div>
      </div>
      <label>Shot List & Production Notes</label>
      <textarea id="sfNotes" rows="2" placeholder="Key shots, prop requirements, audio gear...">${esc(s?.notes || '')}</textarea>
      <div class="bar" style="margin-top:16px">
        <button class="pri" id="saveShootBtn">Save Shoot</button>
        <button id="cancelShootBtn">Cancel</button>
      </div>
    </div>`;

    $('cancelShootBtn').onclick = () => (container.innerHTML = '');
    $('saveShootBtn').onclick = () => {
      const title = ($('sfTitle') as HTMLInputElement).value.trim();
      const client_name = ($('sfClient') as HTMLSelectElement).value;
      const date = ($('sfDate') as HTMLInputElement).value;
      const time = ($('sfTime') as HTMLInputElement).value.trim();
      const type = ($('sfType') as HTMLSelectElement).value;
      const status = ($('sfStatus') as HTMLSelectElement).value;
      const location = ($('sfLocation') as HTMLInputElement).value.trim();
      const crew = ($('sfCrew') as HTMLInputElement).value.trim();
      const notes = ($('sfNotes') as HTMLTextAreaElement).value.trim();

      if (!title || !date) {
        alert('Please enter a shoot title and date.');
        return;
      }

      if (isNew) {
        const newShoot = { id: 's_' + Date.now(), title, client_name, date, time, type, status, location, crew, notes };
        shoots.push(newShoot);
      } else {
        Object.assign(s, { title, client_name, date, time, type, status, location, crew, notes });
      }
      container.innerHTML = '';
      renderShootGrid();
      renderShootDetail();
      renderOverview();
    };
  }

  $('newShootBtn').onclick = () => shootForm(null);

  // Month navigation for shoot calendar
  $('sPrevMonth').onclick = () => { sM--; if (sM < 0) { sM = 11; sY--; } renderShootGrid(); };
  $('sNextMonth').onclick = () => { sM++; if (sM > 11) { sM = 0; sY++; } renderShootGrid(); };
  $('sTodayBtn').onclick = () => { sY = now.getFullYear(); sM = now.getMonth(); sSel = TODAY; renderShootGrid(); renderShootDetail(); };

  // Run on load
  boot();
</script>
