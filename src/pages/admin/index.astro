---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Studio Admin · Content & Shoot Operations" noindex={true}>
  <!-- Login Container -->
  <div id="loginView" class="login-wrapper">
    <div class="panel login-card">
      <div class="login-header">
        <div class="brand-badge">⚡</div>
        <h2>Team Login</h2>
        <p class="muted">Access your content & production operations</p>
      </div>

      <div class="form-group">
        <label for="em">Email</label>
        <input id="em" type="email" placeholder="admin@domain.com" autocomplete="username" />
      </div>

      <div class="form-group">
        <label for="pw">Password</label>
        <input id="pw" type="password" placeholder="••••••••" autocomplete="current-password" />
      </div>

      <p class="msg" id="msg"></p>

      <div class="login-actions">
        <button class="pri" id="in" style="width:100%">Log in</button>
        <button id="up" class="ghost-btn">Create account</button>
      </div>
    </div>
  </div>

  <!-- Dashboard Container with Left Sidebar -->
  <div id="dashboardView" class="admin-shell" style="display:none">
    <!-- Left Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="sidebar-brand">
          <span class="brand-badge">⚡</span>
          <div class="brand-text">
            <b>DASH</b>
            <span>Studio OS</span>
          </div>
        </div>

        <!-- Sidebar Navigation Menu -->
        <nav class="sidebar-menu">
          <div class="menu-label">DASHBOARD</div>
          <button class="menu-item active" data-tab="overview">
            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg>
            <span>Overview</span>
          </button>

          <div class="menu-label">PRODUCTION & CONTENT</div>
          <button class="menu-item" data-tab="content-calendar">
            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>Content Calendar</span>
          </button>

          <button class="menu-item" data-tab="shoot-calendar">
            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
            <span>Shoot Calendar</span>
            <span class="badge-pill">Production</span>
          </button>
        </nav>
      </div>

      <div class="sidebar-bottom">
        <a href="/" target="_blank" rel="noopener" class="sidebar-link">
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          <span>Client Login View</span>
        </a>
        <button id="logoutBtn" class="sidebar-logout">
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          <span>Log out</span>
        </button>
      </div>
    </aside>

    <!-- Main Content Container -->
    <main class="main-content">
      <!-- 1. OVERVIEW VIEW (Main Section) -->
      <section id="tab-overview" class="tab-pane active">
        <header class="section-header">
          <div>
            <h1>Overview</h1>
            <p class="muted">Content pipeline, production shoots, and client activity</p>
          </div>
          <div class="header-actions">
            <button class="btn-subtle" id="quickNewShoot">+ Schedule Shoot</button>
            <button class="pri" id="quickNewPost">+ Add Post</button>
          </div>
        </header>

        <!-- KPI Metric Cards -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Scheduled Posts</div>
            <div class="stat-value" id="kpi-posts">48</div>
            <div class="stat-sub positive">↑ 14% this month</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Production Shoots</div>
            <div class="stat-value" id="kpi-shoots">6</div>
            <div class="stat-sub highlight">2 scheduled this week</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Active Clients</div>
            <div class="stat-value" id="kpi-clients">4</div>
            <div class="stat-sub">Zahran, Bloom, Pulse, Apex</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Pending Review</div>
            <div class="stat-value" id="kpi-pending">3</div>
            <div class="stat-sub alert">Needs approval</div>
          </div>
        </div>

        <!-- Dashboard Two-Column Grid -->
        <div class="overview-grid">
          <!-- Left Column: Upcoming Shoots & Activity -->
          <div class="col-main">
            <div class="panel">
              <div class="panel-header">
                <h3>Upcoming Shoots This Week</h3>
                <button class="text-btn" id="gotoShootsBtn">View Shoot Calendar →</button>
              </div>
              <div class="shoot-list-compact" id="overviewShootsList">
                <!-- Injected via JS -->
              </div>
            </div>

            <div class="panel" style="margin-top:16px">
              <div class="panel-header">
                <h3>Recent Production Activity</h3>
              </div>
              <div class="activity-feed">
                <div class="activity-item">
                  <span class="act-dot" style="background:#6A9BCC"></span>
                  <div class="act-content">
                    <b>New Reel Created</b> · <i>Zahran Cafe</i>
                    <p>“Film Dialogues Collab Reel” marked as final ready.</p>
                  </div>
                  <span class="act-time">2h ago</span>
                </div>
                <div class="activity-item">
                  <span class="act-dot" style="background:#D97757"></span>
                  <div class="act-content">
                    <b>Shoot Location Booked</b> · <i>Bloom Coffee</i>
                    <p>Rooftop Studio confirmed for barista aesthetic shots.</p>
                  </div>
                  <span class="act-time">5h ago</span>
                </div>
                <div class="activity-item">
                  <span class="act-dot" style="background:#788C5D"></span>
                  <div class="act-content">
                    <b>Post Scheduled</b> · <i>Pulse Fitness</i>
                    <p>Creator workout collab slated for Saturday morning.</p>
                  </div>
                  <span class="act-time">Yesterday</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Content Pipeline -->
          <div class="col-side">
            <div class="panel">
              <div class="panel-header">
                <h3>Upcoming Content</h3>
                <button class="text-btn" id="gotoCalendarBtn">Open Calendar →</button>
              </div>
              <div class="pipeline-list" id="overviewPostsList">
                <!-- Injected via JS -->
              </div>
            </div>

            <div class="panel" style="margin-top:16px">
              <div class="panel-header">
                <h3>Client Access Keys</h3>
              </div>
              <div id="overviewClientKeys" class="client-keys-list">
                <!-- Injected via JS -->
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. CONTENT CALENDAR (Feature) -->
      <section id="tab-content-calendar" class="tab-pane">
        <header class="section-header">
          <div>
            <h1>Content Calendar</h1>
            <p class="muted">Manage client social media schedules and deliverables</p>
          </div>
          <div class="header-actions">
            <button class="pri" id="addPostBtn">+ Add Post</button>
          </div>
        </header>

        <!-- Client Selector & Actions Bar -->
        <div class="bar client-bar">
          <label style="margin:0;font-weight:600">Client:</label>
          <select id="clientSelect" style="max-width:240px" aria-label="Select Client"></select>
          <button id="newClientBtn">+ New Client</button>
          <button id="editClientBtn">Edit Client</button>
          <button id="copyClientKeyBtn" style="font-size:12px;padding:6px 12px">Key: <b id="curKeyLabel"></b> 📋</button>
          <span class="sp"></span>
          <a id="clientCalendarLink" class="btn-link" target="_blank" rel="noopener" href="#">Preview Client View ↗</a>
        </div>

        <!-- Form Container (Client / Post edit) -->
        <div id="contentFormContainer"></div>

        <!-- Calendar Filter & Navigation Bar -->
        <div class="bar" id="contentFilters" role="group" aria-label="Filter posts"></div>
        <div class="bar">
          <button id="cPrevMonth">‹ Prev</button>
          <div class="month" id="cMonthLabel"></div>
          <button id="cNextMonth">Next ›</button>
          <span class="sp"></span>
          <button id="cTodayBtn">Jump to today</button>
        </div>

        <!-- Grid & Detail Panel -->
        <div class="grid" id="cDows"></div>
        <div class="grid" id="cGrid" style="margin-top:6px"></div>
        <div class="panel" id="cDetail"></div>

        <!-- Posts List Table -->
        <div class="panel" style="margin-top:24px">
          <div class="panel-header">
            <h3>Scheduled Deliverables</h3>
          </div>
          <div id="postsList"></div>
        </div>
      </section>

      <!-- 3. SHOOT CALENDAR (Third Item in Left Side Menu) -->
      <section id="tab-shoot-calendar" class="tab-pane">
        <header class="section-header">
          <div>
            <h1>Shoot Calendar</h1>
            <p class="muted">Video production, photoshoots, studio bookings & call times</p>
          </div>
          <div class="header-actions">
            <button class="pri" id="newShootBtn">+ Schedule Shoot</button>
          </div>
        </header>

        <!-- Shoot Form Container -->
        <div id="shootFormContainer"></div>

        <!-- Filter & Month Bar -->
        <div class="bar" id="shootFilters" role="group" aria-label="Filter shoots"></div>
        <div class="bar">
          <button id="sPrevMonth">‹ Prev</button>
          <div class="month" id="sMonthLabel"></div>
          <button id="sNextMonth">Next ›</button>
          <span class="sp"></span>
          <button id="sTodayBtn">Jump to today</button>
        </div>

        <!-- Shoots Grid -->
        <div class="grid" id="sDows"></div>
        <div class="grid" id="sGrid" style="margin-top:6px"></div>

        <!-- Shoot Detail Drawer -->
        <div class="panel" id="sDetail"></div>
      </section>
    </main>
  </div>
</Layout>

<style>
  /* Admin Shell & Layout */
  .login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .login-card {
    width: 100%;
    max-width: 400px;
    padding: 32px 28px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }
  .login-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .login-header h2 {
    margin: 8px 0 4px;
    font-size: 24px;
  }
  .brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--sel);
    color: var(--bg);
    font-size: 20px;
  }
  .ghost-btn {
    background: transparent;
    border: none;
    color: var(--mute);
    font-size: 13px;
    text-decoration: underline;
    margin-top: 10px;
    width: 100%;
  }

  /* Admin Dashboard Layout */
  .admin-shell {
    display: flex;
    min-height: 100vh;
  }
  .sidebar {
    width: 260px;
    background: var(--head);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 24px 16px;
  }
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px 24px 8px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }
  .brand-text b {
    display: block;
    font-size: 18px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .brand-text span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
  }
  .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--mute);
    padding: 12px 12px 6px 12px;
  }
  .menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--mute);
    cursor: pointer;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    transition: all 0.15s ease;
  }
  .menu-item:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.04);
  }
  .menu-item.active {
    color: var(--ink);
    background: var(--card);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    font-weight: 600;
  }
  .menu-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .badge-pill {
    margin-left: auto;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--reelbg);
    color: var(--reel);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .sidebar-bottom {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar-link, .sidebar-logout {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    color: var(--mute);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
  }
  .sidebar-link:hover, .sidebar-logout:hover {
    color: var(--ink);
    background: rgba(0,0,0,0.04);
  }

  /* Main Area */
  .main-content {
    flex: 1;
    padding: 32px 40px;
    max-width: 1360px;
    overflow-y: auto;
  }
  .tab-pane {
    display: none;
  }
  .tab-pane.active {
    display: block;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .section-header h1 {
    font-size: 28px;
    font-weight: 600;
    margin: 0;
  }
  .section-header p {
    margin: 4px 0 0;
  }
  .header-actions {
    display: flex;
    gap: 10px;
  }
  .btn-subtle {
    background: var(--head);
    border: 1.5px solid var(--line);
  }
  .btn-link {
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .stat-card {
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
  }
  .stat-label {
    font-size: 12px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .stat-value {
    font-size: 32px;
    font-weight: 700;
    margin: 6px 0 4px;
    line-height: 1;
  }
  .stat-sub {
    font-size: 12px;
    color: var(--mute);
  }
  .stat-sub.positive { color: #2e7d32; }
  .stat-sub.highlight { color: #1976d2; font-weight: 600; }
  .stat-sub.alert { color: var(--bad); font-weight: 600; }

  /* Two Column Overview Grid */
  .overview-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
  }
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .panel-header h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }
  .text-btn {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }

  /* Shoot list compact */
  .shoot-item-compact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--head);
    border-radius: 10px;
    margin-bottom: 8px;
    gap: 12px;
  }
  .shoot-date-badge {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 4px 8px;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    min-width: 50px;
  }
  .shoot-meta b {
    display: block;
    font-size: 14px;
  }
  .shoot-meta span {
    font-size: 12px;
    color: var(--mute);
  }

  /* Activity feed */
  .activity-feed {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .activity-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .activity-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .act-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 5px;
    flex-shrink: 0;
  }
  .act-content p {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--mute);
  }
  .act-time {
    margin-left: auto;
    font-size: 11px;
    color: var(--mute);
    white-space: nowrap;
  }

  /* Pipeline List */
  .pipeline-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .pipeline-item:last-child {
    border-bottom: none;
  }
  .pipeline-info b {
    display: block;
    font-size: 13px;
  }
  .pipeline-info span {
    font-size: 12px;
    color: var(--mute);
  }

  /* Shoot chip styling on calendar */
  .chip.shoot-reel { background: #E1ECF6; border-color: #2196F3; }
  .chip.shoot-photo { background: #F8E4DB; border-color: #FF9800; }
  .chip.shoot-loc { background: #E6EBDD; border-color: #4CAF50; }
  .chip.shoot-bts { background: #F6E0E7; border-color: #9C27B0; }

  /* Client Keys List */
  .key-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    font-size: 13px;
    border-bottom: 1px solid var(--line);
  }
  .key-row:last-child { border-bottom: none; }
  .key-row code {
    background: var(--head);
    padding: 2px 6px;
    border-radius: 6px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .admin-shell {
      flex-direction: column;
    }
    .sidebar {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding: 16px;
    }
    .sidebar-menu {
      flex-direction: row;
      overflow-x: auto;
      gap: 8px;
    }
    .menu-label {
      display: none;
    }
    .overview-grid {
      grid-template-columns: 1fr;
    }
    .main-content {
      padding: 18px 16px;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: any) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[c] || c));
  const pad = (n: number) => String(n).padStart(2, '0');

  const MN = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];
  const DN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  // Current date
  const now = new Date();
  const TODAY = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

  // ==========================================
  // DUMMY DATA SOURCES (Clients, Posts, Shoots)
  // ==========================================
  const DUMMY_CLIENTS = [
    { id: 'c1', name: 'Zahran Cafe & Restaurant', slug: 'zahran', accent_color: '#D97757' },
    { id: 'c2', name: 'Bloom Coffee Roasters', slug: 'bloom', accent_color: '#4E6E58' },
    { id: 'c3', name: 'Pulse Athletic Club', slug: 'pulse', accent_color: '#3B82F6' },
    { id: 'c4', name: 'Apex Streetwear', slug: 'apex', accent_color: '#8B5CF6' }
  ];

  let clients = [...DUMMY_CLIENTS];
  let curClient = clients[0];

  // Helper date generator around current month
  const yr = now.getFullYear();
  const mo = now.getMonth() + 1;
  const pDate = (d: number) => `${yr}-${pad(mo)}-${pad(d)}`;

  let dummyPosts: Record<string, any[]> = {
    c1: [
      { id: 'p1', client_id: 'c1', post_date: pDate(3), type: 'Poster', pillar: 'Special Menu', content: 'Autumn Spice Latte & Dessert pairing promo', status: 'posted', ref_link: 'https://instagram.com/p/1', image_url: null },
      { id: 'p2', client_id: 'c1', post_date: pDate(6), type: 'Reel', pillar: 'Kitchen Story', content: 'Chef secret pasta preparation reel with trending audio', status: 'posted', ref_link: 'https://instagram.com/reel/2', image_url: null },
      { id: 'p3', client_id: 'c1', post_date: pDate(10), type: 'Poster', pillar: 'Weekend Special', content: 'Brunch buffet offer 20% discount graphic', status: 'ready', ref_link: '', image_url: null },
      { id: 'p4', client_id: 'c1', post_date: pDate(14), type: 'Reel', pillar: 'Collab', content: 'Food influencer dining review clip', status: 'ready', ref_link: 'https://instagram.com/reel/4', image_url: null },
